# Dependências e arquivos gerados pela compilação
node_modules/
server/dist/
extension/dist/

# Campanhas de vocês (história, fichas, rolagens, mapas): ficam só neste computador.
# Só o modelo de campanha vai para o repositório.
campanhas/*
!campanhas/_modelo/

# Material com direitos autorais e documentos pessoais
*.pdf
*.docx

# Configuração local desta máquina (tem o caminho da pasta no seu computador)
.mcp.json
.claude/settings.local.json

# Tokens gerados a partir de icons/ (npm run build:tokens)
extension/public/tokens/
