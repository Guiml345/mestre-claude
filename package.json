{
  "name": "mestre-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mestre de RPG com Claude: servidor MCP + extensao do Owlbear Rodeo",
  "scripts": {
    "build": "npm run build:server && npm run build:ext",
    "build:server": "tsc -p server",
    "build:ext": "tsc -p extension && vite build extension",
    "test": "npm run build:server && node --test \"server/dist/**/*.test.js\"",
    "dev:ext": "vite extension",
    "mesa": "node server/dist/cli.js",
    "simulador": "node simulador/servidor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@owlbear-rodeo/sdk": "^3.1.0",
    "sharp": "^0.34.5",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
